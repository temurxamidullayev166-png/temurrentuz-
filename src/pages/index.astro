
<!DOCTYPE html>
<html lang="uz">

<head>

    <!-- Sahifaning asosiy kodlash va ekran sozlamalari -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Brauzer oynasidagi sayt nomi -->
    <title>TEMURrentUZ</title>

    <!-- Font Awesome: sayt ikonkalari -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Supabase: kelajakda ma'lumotlar bazasi bilan ishlash uchun -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <!-- TensorFlow.js: sun'iy intellektni brauzerda ishlatish uchun -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0"></script>

    <!-- COCO-SSD: rasm va videodagi obyektlarni aniqlash modeli -->
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3"></script>


    <!-- =====================================================
         SAYTNING CSS DIZAYNI
         Mavjud ranglar, o'lchamlar va stillar saqlangan.
         ===================================================== -->

    <style>

        /* Sayt bo'ylab ishlatiladigan asosiy ranglar */
        :root {
            --primary: #3b82f6;
            --secondary: #10b981;
            --dark: #070b14;
            --card-bg: rgba(255, 255, 255, 0.06);
            --border: rgba(255, 255, 255, 0.1);
            --error: #ef4444;
        }

        /* Barcha elementlarning boshlang'ich sozlamalari */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        /* Saytning umumiy fon va matn ko'rinishi */
        body {
            background: radial-gradient(circle at top right, #1e293b, #070b14);
            color: #f8fafc;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Til, davlat va profil oynalarining umumiy ko'rinishi */
        #overlay-screen,
        #country-overlay,
        #profile-overlay {
            position: fixed;
            inset: 0;
            background: var(--dark);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* Profil oynasining ko'rinishi */
        #profile-overlay {
            background: rgba(7, 11, 20, 0.95);
            backdrop-filter: blur(15px);
            z-index: 1200;
        }

        /* Davlat tanlash oynasining ko'rinishi */
        #country-overlay {
            background: rgba(7, 11, 20, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1100;
        }

        /* Til va davlat tugmalari joylashadigan grid */
        .scroll-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 15px;
            max-width: 1000px;
            width: 90%;
            margin-top: 20px;
            max-height: 70vh;
            overflow-y: auto;
            padding: 20px;
        }

        /* Umumiy tugmalar dizayni */
        .action-btn {
            padding: 12px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            color: white;
            border-radius: 12px;
            cursor: pointer;
            transition: 0.3s;
            font-size: 14px;
            text-align: center;
        }

        /* Tugma ustiga sichqoncha olib borilgandagi holat */
        .action-btn:hover {
            background: var(--primary);
            transform: translateY(-3px);
        }

        /* Saytning yuqori navigatsiya paneli */
        header {
            padding: 20px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(7, 11, 20, 0.8);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        /* TEMURrentUZ logotipi */
        .logo {
            font-size: 26px;
            font-weight: 900;
            background: linear-gradient(to right, #3b82f6, #60a5fa);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            display: inline-block;
            cursor: pointer;
        }

        /* Profil tugmasining joylashuvi */
        .profile-trigger {
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 5px 10px;
            border-radius: 20px;
            transition: 0.3s;
        }

        /* Profil tugmasining hover holati */
        .profile-trigger:hover {
            background: var(--card-bg);
        }

        /* Saytning asosiy kontent konteyneri */
        .container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Formaning umumiy kartochkasi */
        .card {
            background: var(--card-bg);
            backdrop-filter: blur(25px);
            border: 1px solid var(--border);
            border-radius: 30px;
            padding: 35px;
            animation: fadeIn 0.5s ease;
        }

        /* Sahifa elementlarining paydo bo'lish animatsiyasi */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Ijaraga berish va olish kartochkalari */
        .choice-btns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        /* Tanlov kartochkasining ko'rinishi */
        .choice-card {
            padding: 40px 20px;
            text-align: center;
            border-radius: 25px;
            cursor: pointer;
            transition: 0.4s;
            border: 1px solid var(--border);
            background: var(--card-bg);
        }

        /* Tanlov kartochkasining hover holati */
        .choice-card:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
        }

        /* Forma inputlari joylashadigan guruh */
        .input-group {
            margin-bottom: 15px;
            position: relative;
        }

        /* Matn kiritish maydonlarining dizayni */
        input {
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(15, 23, 42, 0.6);
            color: white;
            outline: none;
            transition: 0.3s;
        }

        /* Noto'g'ri kiritilgan ma'lumot maydoni */
        input.error {
            border-color: var(--error);
            box-shadow: 0 0 5px rgba(239, 68, 68, 0.3);
        }

        /* Xatolik matnining ko'rinishi */
        .error-text {
            color: var(--error);
            font-size: 11px;
            margin-top: 4px;
            display: none;
        }

        /* 4 ta rasm va 1 ta video yuklash maydonlari */
        .media-upload {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 10px;
            margin-top: 15px;
            margin-bottom: 5px;
        }

        /* Har bir media yuklash kartochkasi */
        .media-box {
            background: rgba(255,255,255,0.05);
            border: 1px dashed var(--border);
            border-radius: 10px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            position: relative;
            transition: 0.3s;
        }

        /* Fayl xato bo'lgandagi ko'rinish */
        .media-box.error {
            border-color: var(--error);
        }

        /* Fayl tekshiruvdan o'tgandagi ko'rinish */
        .media-box.filled {
            border-color: var(--secondary);
            color: var(--secondary);
        }

        /* Elementni yashirish klassi */
        .hidden {
            display: none !important;
        }

        /* Formani yuborish tugmasi */
        .btn-submit {
            width: 100%;
            padding: 16px;
            background: var(--primary);
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 15px;
            cursor: pointer;
            font-size: 16px;
            margin-top: 10px;
        }

        /* Profil oynasidagi kartochka */
        .profile-menu-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 30px;
            border-radius: 25px;
            width: 320px;
            text-align: center;
        }

        /* Profil rasmi o'rnidagi avatar */
        .profile-avatar {
            width: 80px;
            height: 80px;
            background: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 35px;
            margin: 0 auto 15px;
        }

        /* Profil menyusidagi tugmalar */
        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: 0.2s;
            text-align: left;
            width: 100%;
            background: none;
            color: white;
            border: none;
        }

        /* Profil menyusi tugmasining hover holati */
        .menu-item:hover {
            background: rgba(255,255,255,0.05);
        }

    </style>

</head>

<body>

    <!-- =====================================================
         1. TIL TANLASH OYNASI
         Foydalanuvchi saytga kirganda tilni tanlaydi.
         ===================================================== -->

    <div id="overlay-screen">

        <!-- Sayt logotipi -->
        <div class="logo" style="margin-bottom: 20px; font-size: 32px;">
            TEMURrentUZ
        </div>

        <!-- Til tanlash sarlavhasi -->
        <h2 id="overlay-title">Select Language</h2>

        <!-- JavaScript orqali tillar tugmalari joylashtiriladi -->
        <div class="scroll-grid" id="overlay-content"></div>

    </div>


    <!-- =====================================================
         2. DAVLAT TANLASH OYNASI
         Foydalanuvchi telefon kodi uchun davlat tanlaydi.
         ===================================================== -->

    <div id="country-overlay" class="hidden">

        <h2>Select Country</h2>

        <!-- Davlatlar tugmalari shu yerga qo'shiladi -->
        <div class="scroll-grid" id="country-content"></div>

        <!-- Davlat tanlash oynasini yopish -->
        <button onclick="closeCountryPicker()"
                class="action-btn"
                style="margin-top: 20px; background: #ef4444;">
            Cancel
        </button>

    </div>


    <!-- =====================================================
         3. PROFIL OYNASI
         Ro'yxatdan o'tmagan va o'tgan foydalanuvchi ko'rinishi.
         ===================================================== -->

    <div id="profile-overlay" class="hidden">

        <div class="profile-menu-card">

            <!-- Mehmon rejimi -->
            <div id="guest-profile">

                <div class="profile-avatar" style="background: #64748b;">
                    <i class="fas fa-user-secret"></i>
                </div>

                <h3>Guest Mode</h3>

                <p style="font-size: 12px; opacity: 0.6; margin-bottom: 20px;">
                    You are not logged in
                </p>

                <button class="menu-item"
                        onclick="goHome(); closeProfile()">
                    <i class="fas fa-sign-in-alt"></i>
                    Login / Register
                </button>

                <button class="menu-item">
                    <i class="fas fa-cog"></i>
                    Settings
                </button>

            </div>


            <!-- Ro'yxatdan o'tgan foydalanuvchi profili -->
            <div id="user-profile" class="hidden">

                <div class="profile-avatar">
                    <i class="fas fa-user"></i>
                </div>

                <h3 id="prof-name">User Name</h3>

                <p id="prof-phone"
                   style="font-size: 12px; opacity: 0.6; margin-bottom: 20px;">
                    +998 00 000 00 00
                </p>

                <button class="menu-item">
                    <i class="fas fa-shield-alt"></i>
                    Security & Privacy
                </button>

                <button class="menu-item">
                    <i class="fas fa-cog"></i>
                    Settings
                </button>

                <!-- Profildan chiqish -->
                <button class="menu-item"
                        style="color: #ef4444;"
                        onclick="location.reload()">
                    <i class="fas fa-power-off"></i>
                    Logout
                </button>

            </div>

            <!-- Profil oynasini yopish -->
            <button class="action-btn"
                    onclick="closeProfile()"
                    style="margin-top: 20px; width: 100%;">
                Close
            </button>

        </div>

    </div>


    <!-- =====================================================
         4. SAYTNING YUQORI PANELI
         Logotip va profil tugmasi.
         ===================================================== -->

    <header>

        <!-- Logotip bosilganda bosh sahifaga qaytadi -->
        <div class="logo" onclick="handleLogoClick()">
            TEMURrentUZ
        </div>

        <!-- Profil oynasini ochish -->
        <div class="profile-trigger" onclick="openProfile()">

            <i class="fas fa-user-circle fa-lg"></i>

            <span id="txt-login">Login</span>

        </div>

    </header>


    <!-- =====================================================
         5. SAYTNING ASOSIY QISMI
         Ijaraga berish yoki ijaraga olish tanlovi.
         ===================================================== -->

    <div class="container">

        <!-- Foydalanuvchi tanlaydigan ikkita asosiy yo'nalish -->
        <div id="step-choice" class="choice-btns">

            <!-- Avtomobilni ijaraga berish -->
            <div class="choice-card" onclick="showRegistration('give')">

                <i class="fas fa-key fa-3x"
                   style="color: var(--primary); margin-bottom: 15px;"></i>

                <h3 id="txt-give">Rent Out</h3>

                <p id="txt-givesub"
                   style="font-size: 13px; opacity: 0.5;">
                    Add a car
                </p>

            </div>

            <!-- Avtomobilni ijaraga olish -->
            <div class="choice-card" onclick="showRegistration('take')">

                <i class="fas fa-search fa-3x"
                   style="color: var(--secondary); margin-bottom: 15px;"></i>

                <h3 id="txt-take">Rent In</h3>

                <p id="txt-takesub"
                   style="font-size: 13px; opacity: 0.5;">
                    Search car
                </p>

            </div>

        </div>


        <!-- =================================================
             6. RO'YXATDAN O'TISH FORMASI
             Ijaraga beruvchi yoki oluvchi ma'lumotlarini kiritadi.
             ================================================= -->

        <div id="form-register" class="card hidden">

            <h2 id="reg-title"
                style="margin-bottom: 25px; text-align: center;">
                Registration
            </h2>

            <!-- Foydalanuvchining ism-familiyasi -->
            <div class="input-group">

                <input type="text"
                       id="inp-name"
                       placeholder="Full Name (e.g. John Doe)">

                <div class="error-text">
                    Invalid name (Enter first and last name)
                </div>

            </div>


            <!-- Telefon kodi va telefon raqami -->
            <div style="display: flex; gap: 10px; margin-bottom: 15px;">

                <!-- Davlat kodini tanlash -->
                <button onclick="openCountryPicker()"
                        id="country-code-btn"
                        style="flex: 0.35; height: 50px;"
                        class="action-btn">
                    +998
                </button>

                <!-- Telefon raqami -->
                <div class="input-group"
                     style="flex: 1; margin-bottom: 0;">

                    <input type="text"
                           id="inp-phone"
                           placeholder="Phone (901234567)">

                    <div class="error-text">
                        Invalid phone number
                    </div>

                </div>

            </div>


            <!-- Faqat avtomobilni ijaraga berish rejimida ko'rinadi -->
            <div id="extra-fields" class="hidden">

                <!-- Avtomobil modeli -->
                <div class="input-group">

                    <input type="text"
                           id="inp-model"
                           placeholder="Car Model">

                    <div class="error-text">
                        Model required
                    </div>

                </div>


                <!-- Avtomobil joylashgan manzil -->
                <div class="input-group">

                    <input type="text"
                           id="inp-loc"
                           placeholder="Location">

                    <div class="error-text">
                        Location required
                    </div>

                </div>


                <!-- Oylik va yillik ijara narxi -->
                <div style="display: flex; gap: 10px;">

                    <div class="input-group" style="flex:1">

                        <input type="number"
                               id="inp-mon"
                               placeholder="Monthly ($)">

                        <div class="error-text">
                            Invalid price
                        </div>

                    </div>

                    <div class="input-group" style="flex:1">

                        <input type="number"
                               id="inp-year"
                               placeholder="Yearly ($)">

                        <div class="error-text">
                            Invalid price
                        </div>

                    </div>

                </div>


                <!-- =========================================
                     7. AVTOMOBIL RASMLARI VA VIDEOSI
                     Har bir fayl AI tomonidan tekshiriladi.
                     ========================================= -->

                <div class="media-upload">

                    <!-- Birinchi rasm -->
                    <div class="media-box"
                         id="box-p1"
                         onclick="document.getElementById('file-p1').click()">

                        <i class="fas fa-camera"></i>

                        <input type="file"
                               id="file-p1"
                               class="hidden"
                               accept="image/*"
                               onclick="event.stopPropagation()"
                               onchange="checkFile(this)">

                    </div>


                    <!-- Ikkinchi rasm -->
                    <div class="media-box"
                         id="box-p2"
                         onclick="document.getElementById('file-p2').click()">

                        <i class="fas fa-camera"></i>

                        <input type="file"
                               id="file-p2"
                               class="hidden"
                               accept="image/*"
                               onclick="event.stopPropagation()"
                               onchange="checkFile(this)">

                    </div>


                    <!-- Uchinchi rasm -->
                    <div class="media-box"
                         id="box-p3"
                         onclick="document.getElementById('file-p3').click()">

                        <i class="fas fa-camera"></i>

                        <input type="file"
                               id="file-p3"
                               class="hidden"
                               accept="image/*"
                               onclick="event.stopPropagation()"
                               onchange="checkFile(this)">

                    </div>


                    <!-- To'rtinchi rasm -->
                    <div class="media-box"
                         id="box-p4"
                         onclick="document.getElementById('file-p4').click()">

                        <i class="fas fa-camera"></i>

                        <input type="file"
                               id="file-p4"
                               class="hidden"
                               accept="image/*"
                               onclick="event.stopPropagation()"
                               onchange="checkFile(this)">

                    </div>


                    <!-- Avtomobil videosi -->
                    <div class="media-box"
                         id="box-v1"
                         style="border-style: solid;"
                         onclick="document.getElementById('file-v1').click()">

                        <i class="fas fa-video"></i>

                        <input type="file"
                               id="file-v1"
                               class="hidden"
                               accept="video/*"
                               onclick="event.stopPropagation()"
                               onchange="checkFile(this)">

                    </div>

                </div>


                <!-- AI tekshiruvi jarayoni haqida xabar -->
                <div id="media-status"
                     style="font-size: 11px; margin: 8px 0; opacity: 0.8;"
                     aria-live="polite">
                </div>

                <!-- Media xatolik xabari -->
                <div class="error-text"
                     id="err-media"
                     style="margin-bottom: 15px;">
                    Please upload all 4 photos and 1 video
                </div>

            </div>


            <!-- Formani davom ettirish tugmasi -->
            <button class="btn-submit"
                    id="btn-next"
                    onclick="handleFormSubmit()">
                Continue
            </button>

            <!-- Oldingi oynaga qaytish -->
            <p onclick="goBack()"
               style="text-align: center; margin-top: 15px; cursor: pointer; opacity: 0.4;"
               id="txt-back">
                ← Back
            </p>

        </div>


        <!-- =================================================
             8. AVTOMOBILLAR NATIJALARI
             Ijaraga olish tanlanganda ko'rsatiladi.
             ================================================= -->

        <div id="car-results" class="hidden">

            <h2 id="txt-title-take">Available Cars</h2>

            <div class="car-grid">

                <div class="car-item">
                    <h3>Chevrolet Tahoe</h3>
                    <p>$1200/mo</p>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         9. JAVASCRIPT — ASOSIY SOZLAMALAR
         ===================================================== -->


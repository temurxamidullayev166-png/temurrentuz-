        isRegistered = true;

        // Ismni saqlaymiz.
        userData.name = name;

        // Telefonni davlat kodi bilan saqlaymiz.
        userData.phone =
            countryCode + ' ' + phone;

        // Profil oynasidagi ma'lumotlarni yangilaymiz.
        document.getElementById('prof-name').innerText =
            userData.name;

        document.getElementById('prof-phone').innerText =
            userData.phone;

        // Login tugmasiga ismni chiqaramiz.
        document.getElementById('txt-login').innerText =
            userData.name.split(' ')[0];

        // Mehmon profilini yashiramiz.
        document.getElementById('guest-profile').classList.add('hidden');

        // Foydalanuvchi profilini ko'rsatamiz.
        document.getElementById('user-profile').classList.remove('hidden');


        // --------------------------------------------
        // IJARAGA OLISH REJIMI
        // --------------------------------------------

        if (currentMode === 'take') {

            document.getElementById('form-register').classList.add('hidden');

            document.getElementById('car-results').classList.remove('hidden');

        }

        // --------------------------------------------
        // IJARAGA BERISH REJIMI
        // --------------------------------------------

        else {

            alert('Success!');

            goHome();
        }
    }
}
            /* ================================================
               29. BARCHA TEKSHIRUVLAR MUVAFFAQIYATLI TUGASA
               ================================================ */

           


        /* =====================================================
           30. ORQAGA QAYTISH
           ===================================================== */

        function goBack() {
            goHome();
        }


        /* =====================================================
           31. DAVLAT TANLASH OYNASINI BOSHQARISH
           ===================================================== */

        // Davlat tanlash oynasini ochish.
        function openCountryPicker() {
            document.getElementById('country-overlay').classList.remove('hidden');
        }

        // Davlat tanlash oynasini yopish.
        function closeCountryPicker() {
            document.getElementById('country-overlay').classList.add('hidden');
        }

        // Tanlangan davlat kodini telefon tugmasiga joylashtirish.
        function selectCountry(code) {

            document.getElementById('country-code-btn').innerText = code;

            closeCountryPicker();
        }


        /* =====================================================
           32. DAVLAT TUGMALARINI YARATISH
           ===================================================== */

        const countryContent = document.getElementById('country-content');

        countries.forEach(country => {

            // Har bir davlat uchun tugma yaratamiz.
            const button = document.createElement('button');

            button.className = 'action-btn';

            // Davlat kodi va nomini ko'rsatamiz.
            button.innerHTML =
                `<b>${country.c}</b><br><small>${country.n}</small>`;

            // Bosilganda davlat kodini tanlaymiz.
            button.onclick = () => selectCountry(country.c);

            countryContent.appendChild(button);
        });


        /* =====================================================
           33. SAHIFA YUKLANGANDA BOSHLANG'ICH SOZLAMALAR
           ===================================================== */

        // Dastlab barcha media fayllar tekshiruvdan o'tmagan.
        mediaIds.forEach(id => {

            const input = document.getElementById(id);

            input.dataset.validated = 'false';
        });

        // Boshlanishida tugma holatini yangilaymiz.
        updateSubmitButton();

    </script>

</body>

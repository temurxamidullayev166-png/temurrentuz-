<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#070b14">
    <title>TEMURrentUZ</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/coco-ssd@2.2.3"></script>

    <style>
        :root {
            --primary: #3b82f6;
            --secondary: #10b981;
            --dark: #070b14;
            --card-bg: rgba(255,255,255,.06);
            --border: rgba(255,255,255,.1);
            --error: #ef4444;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Inter, Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            color: #f8fafc;
            background: radial-gradient(circle at top right, #1e293b, #070b14);
        }

        button, input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        .hidden {
            display: none !important;
        }

        #overlay-screen,
        #country-overlay,
        #profile-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: var(--dark);
        }

        #country-overlay {
            z-index: 1100;
            background: rgba(7,11,20,.97);
            backdrop-filter: blur(10px);
        }

        #profile-overlay {
            z-index: 1200;
            background: rgba(7,11,20,.95);
            backdrop-filter: blur(15px);
        }

        .scroll-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(140px,1fr));
            gap: 12px;
            width: min(100%,1000px);
            max-height: 70vh;
            overflow-y: auto;
            padding: 20px;
            margin-top: 20px;
        }

        .action-btn {
            padding: 12px;
            color: white;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            transition: .25s;
            text-align: center;
        }

        .action-btn:hover {
            background: var(--primary);
            transform: translateY(-2px);
        }

        header {
            position: sticky;
            top: 0;
            z-index: 100;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 18px 5%;
            background: rgba(7,11,20,.85);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border);
        }

        .logo {
            display: inline-block;
            font-size: 26px;
            font-weight: 900;
            background: linear-gradient(to right,#3b82f6,#60a5fa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            cursor: pointer;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .profile-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 20px;
            cursor: pointer;
            transition: .2s;
        }

        .profile-trigger:hover {
            background: var(--card-bg);
        }

        .container {
            width: min(900px,100%);
            margin: 40px auto;
            padding: 0 20px;
        }

        .card {
            padding: 35px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 30px;
            backdrop-filter: blur(25px);
            animation: fadeIn .4s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .choice-btns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .choice-card {
            padding: 40px 20px;
            text-align: center;
            border: 1px solid var(--border);
            border-radius: 25px;
            background: var(--card-bg);
            cursor: pointer;
            transition: .3s;
        }

        .choice-card:hover {
            border-color: var(--primary);
            transform: translateY(-5px);
        }

        .choice-card p {
            margin-top: 10px;
            font-size: 13px;
            opacity: .6;
        }

        .input-group {
            position: relative;
            flex: 1;
            min-width: 0;
            margin-bottom: 16px;
        }

        input {
            width: 100%;
            padding: 14px;
            color: white;
            background: rgba(15,23,42,.7);
            border: 1px solid var(--border);
            border-radius: 12px;
            outline: none;
            transition: .2s;
        }

        input:focus {
            border-color: var(--primary);
        }

        input.error {
            border-color: var(--error);
            box-shadow: 0 0 5px rgba(239,68,68,.3);
        }

        input::placeholder {
            color: #94a3b8;
        }

        .error-text {
            display: none;
            margin-top: 5px;
            color: var(--error);
            font-size: 11px;
        }

        .phone-row,
        .price-row {
            display: flex;
            gap: 10px;
        }

        #country-code-btn {
            flex: 0 0 100px;
            height: 50px;
        }

        .media-upload {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 10px;
            margin: 15px 0 5px;
        }

        .media-box {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
            height: 75px;
            border: 1px dashed var(--border);
            border-radius: 12px;
            background: rgba(255,255,255,.05);
            cursor: pointer;
            transition: .2s;
        }

        .media-box:hover {
            border-color: var(--primary);
        }

        .media-box.error {
            border-color: var(--error);
            color: var(--error);
        }

        .media-box.filled {
            border-color: var(--secondary);
            color: var(--secondary);
        }

        .media-box small {
            position: absolute;
            bottom: 5px;
            font-size: 9px;
        }

        .btn-submit {
            width: 100%;
            margin-top: 12px;
            padding: 16px;
            color: white;
            font-size: 16px;
            font-weight: bold;
            background: var(--primary);
            border: none;
            border-radius: 15px;
            transition: .2s;
        }

        .btn-submit:hover:not(:disabled) {
            background: #2563eb;
        }

        .btn-submit:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .back-btn {
            margin-top: 18px;
            text-align: center;
            opacity: .65;
            cursor: pointer;
        }

        .profile-menu-card {
            width: min(350px,100%);
            padding: 30px;
            text-align: center;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 25px;
        }

        .profile-avatar {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 80px;
            height: 80px;
            margin: 0 auto 15px;
            color: white;
            font-size: 35px;
            background: var(--primary);
            border-radius: 50%;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 15px;
            color: white;
            text-align: left;
            background: none;
            border: none;
            border-bottom: 1px solid var(--border);
        }

        .menu-item:hover {
            background: rgba(255,255,255,.05);
        }

        .car-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .car-item {
            padding: 25px;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
        }

        .car-item p {
            margin-top: 10px;
            color: var(--secondary);
        }

        #media-status {
            min-height: 18px;
            margin: 8px 0;
            font-size: 12px;
            opacity: .85;
        }

        @media(max-width:600px) {
            header {
                padding: 15px 4%;
            }

            .logo {
                font-size: 21px;
            }

            .container {
                margin: 25px auto;
                padding: 0 12px;
            }

            .card {
                padding: 22px 16px;
                border-radius: 22px;
            }

            .choice-btns {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .choice-card {
                padding: 30px 15px;
            }

            .media-upload {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }

            .price-row {
                flex-direction: column;
                gap: 0;
            }

            .profile-trigger {
                padding: 7px;
            }
        }
    </style>
</head>

<body>

    <!-- Til tanlash -->
    <div id="overlay-screen">
        <div class="logo" style="font-size:32px;margin-bottom:20px">
            TEMURrentUZ
        </div>
        <h2 id="overlay-title">Select Language</h2>
        <div class="scroll-grid" id="overlay-content"></div>
    </div>

    <!-- Davlat tanlash -->
    <div id="country-overlay" class="hidden">
        <h2>Select Country</h2>
        <div class="scroll-grid" id="country-content"></div>
        <button class="action-btn" id="country-cancel"
                style="margin-top:20px;background:#ef4444">
            Cancel
        </button>
    </div>

    <!-- Profil -->
    <div id="profile-overlay" class="hidden">
        <div class="profile-menu-card">

            <div id="guest-profile">
                <div class="profile-avatar" style="background:#64748b">
                    <i class="fas fa-user-secret"></i>
                </div>
                <h3>Guest Mode</h3>
                <p style="font-size:12px;opacity:.6;margin:10px 0 20px">
                    You are not logged in
                </p>
                <button class="menu-item" id="guest-login">
                    <i class="fas fa-sign-in-alt"></i>
                    Login / Register
                </button>
            </div>

            <div id="user-profile" class="hidden">
                <div class="profile-avatar">
                    <i class="fas fa-user"></i>
                </div>
                <h3 id="prof-name">User Name</h3>
                <p id="prof-phone"
                   style="font-size:12px;opacity:.6;margin:10px 0 20px">
                </p>
                <button class="menu-item" id="logout-btn"
                        style="color:#ef4444">
                    <i class="fas fa-power-off"></i>
                    Logout
                </button>
            </div>

            <button class="action-btn" id="profile-close"
                    style="width:100%;margin-top:20px">
                Close
            </button>
        </div>
    </div>

    <!-- Header -->
    <header>
        <div class="logo" id="home-logo">TEMURrentUZ</div>

        <div class="header-actions">
            <button class="action-btn" id="language-btn"
                    title="Change language">
                <i class="fas fa-globe"></i>
            </button>

            <div class="profile-trigger" id="profile-trigger">
                <i class="fas fa-user-circle fa-lg"></i>
                <span id="txt-login">Login</span>
            </div>
        </div>
    </header>

    <main class="container">

        <!-- Bosh sahifa -->
        <section id="step-choice" class="choice-btns">

            <div class="choice-card" id="choice-give">
                <i class="fas fa-key fa-3x"
                   style="color:var(--primary);margin-bottom:15px"></i>
                <h3 id="txt-give">Rent Out</h3>
                <p id="txt-givesub">Add a car</p>
            </div>

            <div class="choice-card" id="choice-take">
                <i class="fas fa-search fa-3x"
                   style="color:var(--secondary);margin-bottom:15px"></i>
                <h3 id="txt-take">Rent In</h3>
                <p id="txt-takesub">Search car</p>
            </div>
        </section>

        <!-- Ro'yxatdan o'tish -->
        <section id="form-register" class="card hidden">

            <h2 id="reg-title"
                style="margin-bottom:25px;text-align:center">
                Registration
            </h2>

            <div class="input-group">
                <input type="text" id="inp-name"
                       placeholder="Full Name (e.g. John Doe)"
                       autocomplete="name">
                <div class="error-text">
                    Ism va familiyangizni kiriting.
                </div>
            </div>

            <div class="phone-row">
                <button class="action-btn" id="country-code-btn">
                    +998
                </button>

                <div class="input-group">
                    <input type="tel" id="inp-phone"
                           placeholder="Phone (901234567)"
                           autocomplete="tel">
                    <div class="error-text">
                        Telefon raqami noto'g'ri.
                    </div>
                </div>
            </div>

            <!-- Faqat mashina berishda ko'rinadi -->
            <div id="extra-fields" class="hidden">

                <div class="input-group">
                    <input type="text" id="inp-model"
                           placeholder="Car Model">
                    <div class="error-text">Model required</div>
                </div>

                <div class="input-group">
                    <input type="text" id="inp-loc"
                           placeholder="Location">
                    <div class="error-text">Location required</div>
                </div>

                <div class="price-row">
                    <div class="input-group">
                        <input type="number" id="inp-mon"
                               placeholder="Monthly ($)" min="1">
                        <div class="error-text">Invalid price</div>
                    </div>

                    <div class="input-group">
                        <input type="number" id="inp-year"
                               placeholder="Yearly ($)" min="1">
                        <div class="error-text">Invalid price</div>
                    </div>
                </div>

                <p style="font-size:12px;opacity:.7">
                    4 ta avtomobil rasmi va 1 ta video yuklang.
                    Rasm: 10 MB gacha. Video: 50 MB gacha.
                </p>

                <div class="media-upload">

                    <label class="media-box" id="box-p1" for="file-p1">
                        <i class="fas fa-camera"></i>
                        <small>Photo 1</small>
                        <input type="file" id="file-p1" class="hidden"
                               accept="image/*">
                    </label>

                    <label class="media-box" id="box-p2" for="file-p2">
                        <i class="fas fa-camera"></i>
                        <small>Photo 2</small>
                        <input type="file" id="file-p2" class="hidden"
                               accept="image/*">
                    </label>

                    <label class="media-box" id="box-p3" for="file-p3">
                        <i class="fas fa-camera"></i>
                        <small>Photo 3</small>
                        <input type="file" id="file-p3" class="hidden"
                               accept="image/*">
                    </label>

                    <label class="media-box" id="box-p4" for="file-p4">
                        <i class="fas fa-camera"></i>
                        <small>Photo 4</small>
                        <input type="file" id="file-p4" class="hidden"
                               accept="image/*">
                    </label>

                    <label class="media-box" id="box-v1" for="file-v1"
                           style="border-style:solid">
                        <i class="fas fa-video"></i>
                        <small>Video</small>
                        <input type="file" id="file-v1" class="hidden"
                               accept="video/*">
                    </label>

                </div>

                <div id="media-status" aria-live="polite"></div>

                <div class="error-text" id="err-media">
                    Please upload all 4 photos and 1 video.
                </div>
            </div>

            <button class="btn-submit" id="btn-next">
                Continue
            </button>

            <p class="back-btn" id="txt-back">← Back</p>
        </section>

        <!-- Mashinalar -->
        <section id="car-results" class="hidden">
            <h2 id="txt-title-take">Available Cars</h2>

            <div class="car-grid">
                <div class="car-item">
                    <h3>Chevrolet Tahoe</h3>
                    <p>$1200/mo</p>
                    <small style="opacity:.6">
                        Demo listing — real listings need a database.
                    </small>
                </div>
            </div>

            <button class="action-btn" id="results-back"
                    style="margin-top:20px">
                ← Back
            </button>
        </section>

    </main>

    <script>

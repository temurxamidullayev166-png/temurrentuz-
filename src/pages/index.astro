            document.getElementById('err-media').style.display = 'none';
        }


        /* =====================================================
           14. FAYLNI RAD ETISH
           Avtomobil topilmasa yoki fayl noto'g'ri bo'lsa ishlaydi.
           ===================================================== */

        function rejectFile(input, message) {

            // Noto'g'ri faylni inputdan o'chiramiz.
            input.value = '';

            // Fayl tekshiruvdan o'tmagan deb belgilanadi.
            input.dataset.validated = 'false';

            // Fayl joylashgan kartochkani topamiz.
            const box = input.closest('.media-box');

            box.classList.remove('filled');
            box.classList.add('error');

            // Foydalanuvchiga xabar ko'rsatamiz.
            showMediaError(message);

            // Tugmani yana bloklaymiz.
            updateSubmitButton();
        }


        /* =====================================================
           15. RASMNI OCHISH
           AI tekshiruvi uchun rasm brauzerda ochiladi.
           ===================================================== */

        function loadImage(file) {

            return new Promise((resolve, reject) => {

                // Vaqtinchalik manzil yaratamiz.
                const url = URL.createObjectURL(file);

                const image = new Image();

                image.onload = () => {
                    URL.revokeObjectURL(url);
                    resolve(image);
                };

                image.onerror = () => {
                    URL.revokeObjectURL(url);
                    reject(new Error('Rasmni ochib bo‘lmadi.'));
                };

                image.src = url;
            });
        }


        /* =====================================================
           16. RASMDA AVTOMOBILNI ANIQLASH
           COCO-SSD modelidan foydalaniladi.
           ===================================================== */

        async function detectCarInImage(file, model) {

            // Tanlangan rasmni ochamiz.
            const image = await loadImage(file);

            // AI rasm ichidagi obyektlarni tekshiradi.
            const predictions = await model.detect(image);

            // Aniqlangan obyektlar orasidan avtomobilni qidiramiz.
            return predictions.some(item =>
                item.class === 'car' &&
                item.score >= CAR_THRESHOLD
            );
        }


        /* =====================================================
           17. VIDEONING YUKLANISHINI KUTISH
           ===================================================== */

        function waitForVideo(video) {

            return new Promise((resolve, reject) => {

                video.onloadeddata = resolve;

                video.onerror = () => {
                    reject(new Error('Videoni ochib bo‘lmadi.'));
                };
            });
        }


        /* =====================================================
           18. VIDEONI KERAKLI KADRGA O'TKAZISH
           ===================================================== */

        function seekVideo(video, time) {

            return new Promise((resolve, reject) => {

                // Video allaqachon kerakli kadrda bo'lsa,
                // kutmasdan davom etamiz.
                if (
                    Math.abs(video.currentTime - time) < 0.01 &&
                    video.readyState >= 2
                ) {
                    resolve();
                    return;
                }

                // Kadrga o'tish muvaffaqiyatli tugasa ishlaydi.
                const done = () => {
                    cleanup();
                    resolve();
                };

                // Kadrga o'tishda xatolik bo'lsa ishlaydi.
                const fail = () => {
                    cleanup();
                    reject(new Error('Video kadrini o‘qib bo‘lmadi.'));
                };

                // Hodisa tinglovchilarini tozalash.
                const cleanup = () => {
                    video.removeEventListener('seeked', done);
                    video.removeEventListener('error', fail);
                };

                video.addEventListener('seeked', done, { once: true });
                video.addEventListener('error', fail, { once: true });

                video.currentTime = time;
            });
        }


        /* =====================================================
           19. VIDEODA AVTOMOBILNI ANIQLASH
           Videoning bosh, o'rta va oxirgi qismlari tekshiriladi.
           ===================================================== */

        async function detectCarInVideo(file, model) {

            const video = document.createElement('video');

            // Video uchun vaqtinchalik manzil.
            const url = URL.createObjectURL(file);

            video.preload = 'auto';
            video.muted = true;
            video.src = url;

            try {

                // Video yuklanishini kutamiz.
                await waitForVideo(video);

                // Video davomiyligini olamiz.
                const duration = video.duration;

                if (!Number.isFinite(duration) || duration <= 0) {
                    throw new Error('Video davomiyligi noto‘g‘ri.');
                }

                // Tekshiriladigan uchta vaqt nuqtasi.
                const sampleTimes = [
                    duration * 0.1,
                    duration * 0.5,
                    duration * 0.9
                ];

                // Har bir kadrni tekshiramiz.
                for (const time of sampleTimes) {

                    await seekVideo(video, time);

                    // Video kadrini canvasga chizamiz.
                    const canvas = document.createElement('canvas');

                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;

                    if (!canvas.width || !canvas.height) {
                        continue;
                    }

                    const context = canvas.getContext('2d');

                    context.drawImage(
                        video,
                        0,
                        0,
                        canvas.width,
                        canvas.height
                    );

                    // AI kadrdagi obyektlarni aniqlaydi.
                    const predictions = await model.detect(canvas);

                    // Avtomobil topilganini tekshiramiz.
                    const carFound = predictions.some(item =>
                        item.class === 'car' &&
                        item.score >= CAR_THRESHOLD
                    );

                    // Avtomobil aniqlansa, muvaffaqiyatli natija qaytaramiz.
                    if (carFound) {
                        return true;
                    }
                }

                // Uchta kadrda ham avtomobil aniqlanmadi.
                return false;

            } finally {

                // Vaqtinchalik manzilni xotiradan bo'shatamiz.
                URL.revokeObjectURL(url);

                video.pause();
                video.removeAttribute('src');
                video.load();
            }
        }


        /* =====================================================
           20. ASOSIY FAYL TEKSHIRUV FUNKSIYASI
           Rasm yoki video tanlanganda shu funksiya ishlaydi.
           ===================================================== */

        async function checkFile(input) {

            // Ushbu input uchun tekshiruv raqamini yangilaymiz.
            const runId = (validationRuns.get(input) || 0) + 1;
            validationRuns.set(input, runId);

            // Oldingi xatolik xabarini yashiramiz.
            hideMediaError();

            // Tanlangan faylni olamiz.
            const file = input.files[0];

            // Fayl joylashgan kartochka.
            const box = input.closest('.media-box');

            // Oldingi tekshiruv holatini tozalaymiz.
            input.dataset.validated = 'false';

            box.classList.remove('filled', 'error');

            // Fayl tanlanmagan bo'lsa, tekshiruvni tugatamiz.
            if (!file) {
                setMediaStatus('');
                updateSubmitButton();
                return;
            }

            // Oxirgi fayl video ekanligini aniqlaymiz.
            const isVideo = input.id === 'file-v1';

            // Fayl turini tekshiramiz.
            if (isVideo && !file.type.startsWith('video/')) {
                rejectFile(input, 'Bu joyga video fayl yuklang.');
                return;
            }

            if (!isVideo && !file.type.startsWith('image/')) {
                rejectFile(input, 'Bu joyga rasm fayl yuklang.');
                return;
            }

            // Fayl hajmini tekshiramiz.
            const maxSize = isVideo
                ? MAX_VIDEO_SIZE
                : MAX_IMAGE_SIZE;

            if (file.size > maxSize) {

                rejectFile(
                    input,
                    isVideo
                        ? 'Video hajmi 50 MB dan oshmasligi kerak.'
                        : 'Rasm hajmi 10 MB dan oshmasligi kerak.'
                );

                return;
            }

            try {

                // AI modeli tayyorlanayotganini bildiramiz.
                setMediaStatus('AI modeli tayyorlanmoqda...');

                // Modelni yuklaymiz yoki mavjud modeldan foydalanamiz.
                const model = await getCarModel();

                // Yangi fayl tanlangan bo'lsa, eski tekshiruvni bekor qilamiz.
                if (validationRuns.get(input) !== runId) return;

                setMediaStatus('AI avtomobilni tekshirmoqda...');

                // Fayl turiga qarab AI tekshiruvini bajaramiz.
                const carFound = isVideo
                    ? await detectCarInVideo(file, model)
                    : await detectCarInImage(file, model);

                // Tekshiruv davomida boshqa fayl tanlangan bo'lsa,
                // eski natijani qo'llamaymiz.
                if (validationRuns.get(input) !== runId) return;

                // Avtomobil aniqlanmasa, faylni rad etamiz.
                if (!carFound) {

                    rejectFile(
                        input,
                        'Xatolik: faylda avtomobil aniqlanmadi. Boshqa fayl tanlang.'
                    );

                    setMediaStatus('');
                    return;
                }

                // Fayl AI tekshiruvidan o'tdi.
                input.dataset.validated = 'true';

                box.classList.remove('error');
                box.classList.add('filled');

                setMediaStatus('Avtomobil aniqlandi. Fayl tekshiruvdan o‘tdi.');

                hideMediaError();

                // Yuborish tugmasi holatini yangilaymiz.
                updateSubmitButton();

            } catch (error) {

                console.error('AI tekshiruvida xatolik:', error);

                // Eskirgan tekshiruv natijasini qo'llamaymiz.
                if (validationRuns.get(input) !== runId) return;

                rejectFile(
                    input,
                    'Faylni AI yordamida tekshirishda xatolik yuz berdi. Qayta urinib ko‘ring.'
                );

                setMediaStatus('');
            }
        }



        // Rasmni brauzerda ochish
        function loadImage(file) {
            return new Promise((resolve, reject) => {
                const url = URL.createObjectURL(file);
                const image = new Image();

                image.onload = () => {
                    URL.revokeObjectURL(url);
                    resolve(image);
                };

                image.onerror = () => {
                    URL.revokeObjectURL(url);
                    reject(new Error("Rasmni ochib bo'lmadi."));
                };

                image.src = url;
            });
        }


        // Rasmdan avtomobilni aniqlash
        async function detectCarInImage(file, model) {
            const image = await loadImage(file);
            const predictions = await model.detect(image);

            return predictions.some(item =>
                item.class === "car" &&
                item.score >= CAR_THRESHOLD
            );
        }


        // Video ma'lumotlari yuklanishini kutish
        function waitForVideo(video) {
            return new Promise((resolve, reject) => {
                if (video.readyState >= 2) {
                    resolve();
                    return;
                }

                const success = () => {
                    cleanup();
                    resolve();
                };

                const failure = () => {
                    cleanup();
                    reject(new Error("Videoni ochib bo'lmadi."));
                };

                const cleanup = () => {
                    video.removeEventListener("loadeddata", success);
                    video.removeEventListener("error", failure);
                };

                video.addEventListener("loadeddata", success, { once:true });
                video.addEventListener("error", failure, { once:true });
            });
        }


        // Videoni kerakli kadrga o'tkazish
        function seekVideo(video, time) {
            return new Promise((resolve, reject) => {
                const success = () => {
                    cleanup();
                    resolve();
                };

                const failure = () => {
                    cleanup();
                    reject(new Error("Video kadrini o'qib bo'lmadi."));
                };

                const cleanup = () => {
                    video.removeEventListener("seeked", success);
                    video.removeEventListener("error", failure);
                };

                video.addEventListener("seeked", success, { once:true });
                video.addEventListener("error", failure, { once:true });

                video.currentTime = time;
            });
        }


        // Videoning uchta kadrini tekshirish
        async function detectCarInVideo(file, model) {
            const video = document.createElement("video");
            const url = URL.createObjectURL(file);

            video.preload = "auto";
            video.muted = true;
            video.src = url;

            try {
                await waitForVideo(video);

                const duration = video.duration;

                if (!Number.isFinite(duration) || duration <= 0) {
                    throw new Error("Video davomiyligi noto'g'ri.");
                }

                const sampleTimes = [
                    duration * 0.1,
                    duration * 0.5,
                    duration * 0.9
                ];

                for (const time of sampleTimes) {
                    await seekVideo(video, time);

                    const canvas = document.createElement("canvas");
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;

                    if (!canvas.width || !canvas.height) continue;

                    const context = canvas.getContext("2d");
                    context.drawImage(video, 0, 0);

                    const predictions = await model.detect(canvas);

                    const carFound = predictions.some(item =>
                        item.class === "car" &&
                        item.score >= CAR_THRESHOLD
                    );

                    if (carFound) return true;
                }

                return false;

            } finally {
                URL.revokeObjectURL(url);
                video.pause();
                video.removeAttribute("src");
                video.load();
            }
        }



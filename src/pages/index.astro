// Maydonda xatolikni ko'rsatish funksiyasi.
function showFieldError(element, message) {

    // Maydonga xatolik klassini qo'shamiz.
    element.classList.add('error');

    // Maydon yonidagi xatolik yozuvini qidiramiz.
    let error = element.parentElement.querySelector('.error-text');

    // Agar topilmasa, keyingi elementni tekshiramiz.
    if (!error && element.nextElementSibling) {
        if (element.nextElementSibling.classList.contains('error-text')) {
            error = element.nextElementSibling;
        }
    }

    // Xatolik xabarini ko'rsatamiz.
    if (error) {
        error.textContent = message;
        error.style.display = 'block';
    }
}


// Maydondagi xatolikni tozalash funksiyasi.
function clearFieldError(element) {

    // Xatolik klassini olib tashlaymiz.
    element.classList.remove('error');

    // Xatolik yozuvini topamiz.
    let error = element.parentElement.querySelector('.error-text');

    if (!error && element.nextElementSibling) {
        if (element.nextElementSibling.classList.contains('error-text')) {
            error = element.nextElementSibling;
        }
    }

    // Xatolikni yashiramiz.
    if (error) {
        error.style.display = 'none';
    }
}



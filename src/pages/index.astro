            const file = input.files[0];
            const box = input.closest(".media-box");
            const isVideo = input.id === "file-v1";

            input.dataset.validated = "false";
            box.classList.remove("filled", "error");
            hideMediaError();

            if (!file) {
                updateSubmitButton();
                return;
            }

            if (isVideo && !file.type.startsWith("video/")) {
                rejectFile(input, "Bu joyga video fayl yuklang.");
                return;
            }

            if (!isVideo && !file.type.startsWith("image/")) {
                rejectFile(input, "Bu joyga rasm fayl yuklang.");
                return;
            }

            const maxSize = isVideo ? MAX_VIDEO_SIZE : MAX_IMAGE_SIZE;

            if (file.size > maxSize) {
                rejectFile(
                    input,
                    isVideo
                        ? "Video hajmi 50 MB dan oshmasligi kerak."
                        : "Rasm hajmi 10 MB dan oshmasligi kerak."
                );
                return;
            }

            try {
                setMediaStatus("AI modeli yuklanmoqda...");

                const model = await getCarModel();

                if (validationRuns.get(input) !== runId) return;

                setMediaStatus("AI avtomobilni tekshirmoqda...");

                const carFound = isVideo
                    ? await detectCarInVideo(file, model)
                    : await detectCarInImage(file, model);

                if (validationRuns.get(input) !== runId) return;

                if (!carFound) {
                    rejectFile(
                        input,
                        "Faylda avtomobil aniqlanmadi. Boshqa fayl tanlang."
                    );
                    setMediaStatus("");
                    return;
                }

                input.dataset.validated = "true";
                box.classList.add("filled");

                setMediaStatus("Avtomobil aniqlandi. Fayl tekshiruvdan o'tdi.");
                hideMediaError();
                updateSubmitButton();

            } catch (error) {
                console.error(error);

                if (validationRuns.get(input) !== runId) return;

                rejectFile(
                    input,
                    "AI tekshiruvida xatolik. Internetni tekshirib, qayta urinib ko'ring."
                );

                setMediaStatus("");
            }
        }


        // Fayllar o'zgarganda tekshiruvni boshlash
        mediaIds.forEach(id => {
            const input = $(id);
            input.dataset.validated = "false";

            input.addEventListener("change", () => checkFile(input));
        });


        // Profilni yangilash
        function updateProfile() {
            $("prof-name").textContent = userData.name;
            $("prof-phone").textContent = userData.phone;
            $("txt-login").textContent = userData.name.split(" ")[0];

            $("guest-profile").classList.add("hidden");
            $("user-profile").classList.remove("hidden");
        }


        // Formani tekshirish va yuborish
        function handleFormSubmit() {
            let allValid = true;

            const nameInput = $("inp-name");
            const name = nameInput.value.trim();

            const nameParts = name.split(/\s+/);

            const validName =
                nameParts.length >= 2 &&
                nameParts.every(part =>
                    /^[\p{L}]+(?:[’'ʻʼ-][\p{L}]+)*$/u.test(part)
                );

            if (!validName) {
                showFieldError(
                    nameInput,
                    "Ism va familiyangizni to'g'ri kiriting."
                );
                allValid = false;
            } else {
                clearFieldError(nameInput);
            }

            const phoneInput = $("inp-phone");
            const phoneDigits = phoneInput.value.replace(/\D/g, "");
            const countryCode = $("country-code-btn").textContent.trim();

            const phoneValid = countryCode === "+998"
                ? /^\d{9}$/.test(phoneDigits)
                : /^\d{7,15}$/.test(phoneDigits);

            if (!phoneValid) {
                showFieldError(
                    phoneInput,
                    countryCode === "+998"
                        ? "O'zbekiston raqami 9 ta raqamdan iborat bo'lishi kerak."
                        : "Telefon raqamini to'g'ri kiriting."
                );
                allValid = false;
            } else {
                clearFieldError(phoneInput);
            }

            if (currentMode === "give") {
                const modelInput = $("inp-model");
                const locationInput = $("inp-loc");
                const monthlyInput = $("inp-mon");
                const yearlyInput = $("inp-year");

                if (modelInput.value.trim().length < 2) {
                    showFieldError(modelInput, "Avtomobil modelini kiriting.");
                    allValid = false;
                } else {
                    clearFieldError(modelInput);
                }

                if (locationInput.value.trim().length < 3) {
                    showFieldError(locationInput, "Manzilni to'g'ri kiriting.");
                    allValid = false;
                } else {
                    clearFieldError(locationInput);
                }

                const monthly = Number(monthlyInput.value);
                const yearly = Number(yearlyInput.value);

                if (
                    monthlyInput.value.trim() === "" ||
                    !Number.isFinite(monthly) ||
                    monthly <= 0
                ) {
                    showFieldError(monthlyInput, "Musbat oylik narx kiriting.");
                    allValid = false;
                } else {
                    clearFieldError(monthlyInput);
                }

                if (
                    yearlyInput.value.trim() === "" ||
                    !Number.isFinite(yearly) ||
                    yearly <= 0
                ) {
                    showFieldError(yearlyInput, "Musbat yillik narx kiriting.");
                    allValid = false;
                } else {
                    clearFieldError(yearlyInput);
                }

                const mediaOk = mediaIds.every(id => {
                    const input = $(id);

                    return input.files.length > 0 &&
                           input.dataset.validated === "true";
                });

                if (!mediaOk) {
                    showMediaError(
                        "4 ta rasm va 1 ta video AI tekshiruvidan o'tishi kerak."
                    );
                    allValid = false;
                } else {
                    hideMediaError();
                }
            }

            if (!allValid) return;

            isRegistered = true;

            userData.name = name;
            userData.phone = countryCode + " " + phoneDigits;

            updateProfile();

            if (currentMode === "take") {
                $("form-register").classList.add("hidden");
                $("car-results").classList.remove("hidden");
            } else {
                alert(
                    "Ma'lumotlar tekshirildi. Hozircha e'lon faqat shu brauzer sessiyasida qoladi. Uni hammaga ko'rsatish uchun ma'lumotlar bazasi kerak."
                );
                goHome();
            }
        }


        // Formani ochish
        function showRegistration(mode) {
            currentMode = mode;

            $("step-choice").classList.add("hidden");
            $("car-results").classList.add("hidden");
            $("form-register").classList.remove("hidden");

            $("extra-fields").classList.toggle("hidden", mode !== "give");

            $("reg-title").textContent =
                mode === "give"
                    ? translations[selectedLanguage].title_give
                    : translations[selectedLanguage].title_take;

            updateSubmitButton();
        }


        // Bosh sahifaga qaytish
        function goHome() {
            $("form-register").classList.add("hidden");
            $("car-results").classList.add("hidden");
            $("step-choice").classList.remove("hidden");

            document.querySelectorAll("input.error").forEach(input => {
                input.classList.remove("error");
            });

            document.querySelectorAll(".error-text").forEach(error => {
                error.style.display = "none";
            });

            setMediaStatus("");
            currentMode = "";
            updateSubmitButton();
        }


        // Profildan chiqish
        function logout() {
            isRegistered = false;
            userData = { name:"", phone:"" };

            $("user-profile").classList.add("hidden");
            $("guest-profile").classList.remove("hidden");

            $("txt-login").textContent =
                translations[selectedLanguage].login;

            closeProfile();
            goHome();
        }


        // Oynalarni ochish va yopish
        function openProfile() {
            $("profile-overlay").classList.remove("hidden");
        }

        function closeProfile() {
            $("profile-overlay").classList.add("hidden");
        }

        function openCountryPicker() {
            $("country-overlay").classList.remove("hidden");
        }

        function closeCountryPicker() {
            $("country-overlay").classList.add("hidden");
        }


        // Tugmalar hodisalari
        $("choice-give").addEventListener("click", () => {
            showRegistration("give");
        });

        $("choice-take").addEventListener("click", () => {
            showRegistration("take");
        });

        $("btn-next").addEventListener("click", handleFormSubmit);
        $("txt-back").addEventListener("click", goHome);
        $("results-back").addEventListener("click", goHome);

        $("profile-trigger").addEventListener("click", openProfile);
        $("profile-close").addEventListener("click", closeProfile);
        $("guest-login").addEventListener("click", () => {
            closeProfile();
            goHome();
        });

        $("logout-btn").addEventListener("click", logout);

        $("country-code-btn").addEventListener("click", openCountryPicker);
        $("country-cancel").addEventListener("click", closeCountryPicker);

        $("language-btn").addEventListener("click", () => {
            $("overlay-screen").classList.remove("hidden");
        });

        $("home-logo").addEventListener("click", () => {
            goHome();
        });


        // Kiritish maydonlaridagi eski xatolikni tozalash
        document.querySelectorAll("input").forEach(input => {
            input.addEventListener("input", () => {
                clearFieldError(input);
            });
        });


        // Dastlabki holat
        updateSubmitButton();
    </script>

</body>
</html>
